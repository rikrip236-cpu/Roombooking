SECRET_KEY=django-insecure-change-me-in-production-64-chars-minimum-required-here
DEBUG=True
# '*' autorise l'acces depuis n'importe quelle IP (pratique pour un usage sur
# reseau local). Pour restreindre a des IP precises une fois en production,
# remplacez par ex. par : localhost,127.0.0.1,192.168.1.42,roombooking.local
ALLOWED_HOSTS=*

# Choix de la base de données : mysql | postgres | sqlite
DB_ENGINE=mysql

DB_NAME=roombooking
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
